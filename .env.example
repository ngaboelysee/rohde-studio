# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/rohde"
# Direct (non-pooled) connection for migrations — Supabase: use port 5432 direct URL
DIRECT_URL="postgresql://postgres:password@localhost:5432/rohde"

# ─── NextAuth (CUSTOMERS ONLY — never used for admin routes) ─────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Supabase (ADMIN AUTH + STORAGE ONLY — server-side service key is secret) ─
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
# SERVER ONLY — never expose. Full admin/storage access.
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
ADMIN_SIGNUP_INVITE_CODE="rotate-this-code-after-initial-admin-creation"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_..."

# ─── Flutterwave ─────────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."
FLUTTERWAVE_SECRET_HASH="webhook-hash"

# ─── Analytics (public measurement IDs — safe to expose) ─────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ─── Atelier Concierge (AI chatbot via OpenRouter) ───────────────────────
# Optional — the concierge degrades gracefully when empty. Free keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional: pin a model (defaults to a free-tier fallback chain)
# OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# ─── WhatsApp checkout channel ───────────────────────────────────────────────
# Cloud API (optional): enables bot push replies + inbound webhook processing.
# Without these, checkout still works via wa.me deep links; replies log server-side.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ─── MTN MoMo Collections (optional server-side verification) ───────────────
# When set, customer-pasted confirmations are checked against the provider API.
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_TARGET_ENV="sandbox"

# ─── Cron protection ────────────────────────────────────────────────────────
# Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""
