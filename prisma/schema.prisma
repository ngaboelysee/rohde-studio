// Rohde — Prisma schema
// PostgreSQL + Prisma ORM. Customer identities live here; admin identities live
// in Supabase Auth, and every admin action is journaled to AdminAuditLog for a
// single source of truth for compliance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMERS (NextAuth / Auth.js — JWT sessions in HTTP-only cookies)
// ─────────────────────────────────────────────────────────────────────────────

/// NextAuth core tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Rohde customer profile. `passwordHash` enables credentials sign-in for
/// accounts that skip OAuth; guest checkout never creates a row here.
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  phone          String?
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  orders      Order[]
  addresses   Address[]
  wishlistItems WishlistItem[]
  reviews     Review[]

  @@index([email])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String   @default("Default")
  fullName     String
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String?
  country      String   @default("NG")
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG — products, variants, inventory
// ─────────────────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// NOTE: Category was previously a Postgres enum with six fixed values.
// It is now a real table so the admin can create, rename and order
// categories from the dashboard without a migration.

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  story       String? // editorial copy for the PDP lookbook block
  categoryId  String
  status      ProductStatus @default(DRAFT)
  basePrice   Decimal       @db.Decimal(12, 2) // minor-agnostic display price
  currency    String        @default("USD")
  dropName    String? // e.g. "ORBIT 001"
  isFeatured  Boolean       @default(false)
  images      String[] // ordered Cloudinary/Supabase Storage URLs
  materials   String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants       Variant[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  category       Category @relation(fields: [categoryId], references: [id])

  @@index([status, categoryId])
  @@index([isFeatured])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  size      String
  color     String  @default("Charcoal")
  price     Decimal? @db.Decimal(12, 2) // falls back to product.basePrice
  image     String?
  active    Boolean @default(true)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

/// Physical stock ledger. Reserved counts stock held by unpaid orders;
/// available = onHand - reserved.
model Inventory {
  id        String   @id @default(cuid())
  variantId String   @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  lowStockThreshold Int @default(3)
  updatedAt DateTime @updatedAt

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMERCE — cart, orders, payments
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FAILED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
  MOBILE_MONEY
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

/// Anonymous guest carts survive on localStorage via the Zustand store; rows
/// here only exist once a cart is claimed at checkout.
model CartItem {
  id        String   @id @default(cuid())
  cartToken String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartToken, variantId])
  @@index([cartToken])
}

model Order {
  id         String      @id @default(cuid())
  orderNumber String     @unique // ROH-XXXXXX
  userId     String? // null for guest checkout
  email      String
  status     OrderStatus @default(PENDING)
  subtotal   Decimal     @db.Decimal(12, 2)
  shipping   Decimal     @default(0) @db.Decimal(12, 2)
  tax        Decimal     @default(0) @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  currency   String      @default("USD")
  provider   PaymentProvider
  providerRef String? // Stripe PaymentIntent / Paystack reference / FLW tx id
  paymentStatus PaymentStatus @default(INITIATED)
  shippingName    String
  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingRegion  String?
  shippingPostal  String?
  shippingCountry String
  shippingPhone   String?
  trackingCode    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payments   Payment[]
  events     OrderEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String
  productName  String // snapshot
  variantSku   String // snapshot
  size         String
  color        String
  image        String?
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id          String         @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  status      PaymentStatus  @default(INITIATED)
  amount      Decimal        @db.Decimal(12, 2)
  currency    String
  providerRef String?
  rawEventId  String? @unique // idempotency key from webhook payloads
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRef])
}

/// Append-only order timeline, written by webhooks and admin actions.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  kind      String // e.g. "payment.captured", "fulfilment.tracking"
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WISHLIST & REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int // 1–5
  title     String?
  body      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN GOVERNANCE — identities live in Supabase Auth; only the audit trail
// and role registry live in PostgreSQL.
// ─────────────────────────────────────────────────────────────────────────────

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  supabaseUserId String  @unique // matches Supabase auth.users.id
  email        String    @unique
  name         String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AdminAuditLog[]
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String // "product.created", "inventory.adjusted", …
  entity    String // "Product", "Variant", "Order", …
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN-DEFINED CATEGORY LABELS
// The Category enum stays fixed (it powers filters, garment mapping and
// analytics) — but the admin owns the customer-facing display name per value,
// plus optional sort order in storefront menus. Rows are created lazily.
// ─────────────────────────────────────────────────────────────────────────────

/// Admin-managed product categories. Seeded with the original six enum
/// values; the dashboard can add more, rename any of them and reorder
/// them for the storefront filter bar.
model Category {
  id         String   @id @default(cuid())
  slug       String   @unique // stable key used by URLs and the concierge
  label      String // customer-facing display name (admin-defined)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true) // false hides it from the storefront filters
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products   Product[]

  @@index([isActive, sortOrder])
}
